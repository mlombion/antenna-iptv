<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Most IPTV providers serve plain http, so the app must be allowed to load it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Antenna Connect: find the Antenna TV app on the home network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Antenna looks for your TV on your home network so you can play channels on it.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_antenna._tcp</string>
	</array>
	<!-- Keeps audio going when the screen locks or the app is in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
